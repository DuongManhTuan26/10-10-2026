# ============================================================================
# Mẫu cấu hình môi trường
#
# Sao chép tệp này thành .env rồi điền giá trị thật:
#   cp .env.example .env
#
# .env đã được .gitignore chặn, không bao giờ commit lên Git.
# ============================================================================

# --- BẮT BUỘC ---------------------------------------------------------------

# Chuỗi kết nối PostgreSQL. Dùng Neon, Supabase hoặc Postgres tự dựng đều được.
# Ví dụ: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# Khóa API Zernio. Lấy tại https://zernio.com → API Keys.
# Quyền cần thiết: Đọc & Ghi, bật "Toàn quyền truy cập (tất cả hồ sơ)".
ZERNIO_API_KEY=""

# Chuỗi ngẫu nhiên dùng để ký cookie phiên đăng nhập.
# Sinh bằng: openssl rand -base64 48
# Đổi giá trị này sẽ đăng xuất toàn bộ người dùng.
SESSION_SECRET=""


# --- TÍNH NĂNG (thiếu thì tính năng tương ứng ngừng hoạt động) ---------------

# Khóa OpenRouter. Lấy tại https://openrouter.ai/settings/keys
# Một khóa dùng chung cho mọi model (Claude, Gemini, GPT...).
# Thiếu khóa này thì mọi tính năng AI trả lỗi.
OPENROUTER_API_KEY=""

# Bí mật xác thực chữ ký webhook, lấy khi đăng ký webhook trong Zernio.
# Thiếu thì endpoint webhook từ chối mọi request — đây là chủ ý,
# vì webhook không kiểm chữ ký cho phép người lạ bơm tin nhắn giả vào hệ thống.
ZERNIO_WEBHOOK_SECRET=""


# --- TÙY CHỌN ---------------------------------------------------------------

ZERNIO_API_BASE_URL="https://zernio.com/api/v1"
APP_URL="http://localhost:3000"

# Đường hầm cho webhook khi chạy trên máy (APP_URL là localhost). Server tự bật
# người canh đường hầm (scripts/tunnel-watchdog.mjs) khi có đường dẫn này. Thiếu
# thì webhook chết, tin của khách chỉ về chậm qua quét bù.
# Cài: brew install cloudflared
CLOUDFLARED_PATH="/usr/local/bin/cloudflared"
NODE_ENV="development"
PORT=3000

# ---------------------------------------------------------------------------
# Telegram — BOT CHUNG của nền tảng
#
# Khách KHÔNG phải tự tạo bot. Họ bấm một liên kết, bấm Start, xong. Bắt mỗi
# shop tự tạo bot rồi tự tra chat id là rào cản mà phần lớn chủ shop không vượt
# qua được.
#
# Lấy token bằng cách nhắn /newbot cho @BotFather, rồi điền cả hai dòng dưới.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Chỉ MỘT bản được nhận lệnh /start. Telegram từ chối khi hai nơi cùng nhận
# ("Conflict: terminated by other getUpdates request"), và khi đó việc liên kết
# Telegram hỏng câm lặng. Chạy nhiều bản thì đặt false ở tất cả trừ một.
TELEGRAM_POLLING="true"

# ---------------------------------------------------------------------------
# Kênh hỗ trợ CỦA MÌNH (tuỳ chọn, dùng cho giao diện)
#
# Nút "Trợ giúp" và link "Liên hệ báo giá riêng" trỏ tới đây. Bỏ trống thì hai
# chỗ đó đưa về trang Gói dịch vụ trong ứng dụng.
#
# TUYỆT ĐỐI không trỏ sang tài liệu của nhà cung cấp hạ tầng: khách trả tiền
# cho mình mà nhìn thấy nhà cung cấp thì họ mua thẳng bên đó.
# Ví dụ: https://zalo.me/..., mailto:hotro@shopcuaban.vn
# ---------------------------------------------------------------------------
VITE_SUPPORT_URL=""

# Số lớp proxy đứng trước máy chủ (Cloudflare, Nginx, nền tảng triển khai...).
# Máy chủ chỉ tin đúng chừng ấy mắt xích cuối của X-Forwarded-For để lấy IP
# thật của khách. Đặt lớn hơn thực tế là khách tự khai IP giả được, né bộ chặn
# dò mật khẩu. Đặt nhỏ hơn là mọi khách bị đếm chung IP của proxy.
TRUST_PROXY_HOPS=1

# --- XÁC THỰC BẰNG EMAIL KHI ĐĂNG NHẬP ---------------------------------------
# Mặc định: BẮT BUỘC khi chạy thật (NODE_ENV=production), TẮT khi thử trên máy.
# Ép bật/tắt: XAC_THUC_EMAIL=bat hoặc XAC_THUC_EMAIL=tat
# Khi bắt buộc mà chưa điền SMTP_USER/SMTP_PASS thì KHÔNG AI đăng nhập được.
XAC_THUC_EMAIL=

# Gửi mã qua Gmail của chủ hệ thống.
# SMTP_USER: địa chỉ Gmail. SMTP_PASS: "Mật khẩu ứng dụng" 16 ký tự của Google
# (Tài khoản Google → Bảo mật → Xác minh 2 bước → Mật khẩu ứng dụng),
# KHÔNG phải mật khẩu Gmail.
SMTP_USER=
SMTP_PASS=
# Mặc định đã đúng cho Gmail, chỉ đổi khi dùng máy chủ email khác.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Tên hiện ở ô "Người gửi" trong email.
EMAIL_TEN_NGUOI_GUI=Quản lý Fanpage
