import { queryOne } from "../../server/db.js";
import { anDiaChiKho } from "../../server/services/media-proxy.js";
const v = await queryOne<{ url: string; anh_mo_dau: string }>("SELECT url, anh_mo_dau FROM video_ai WHERE id = 1 OR anh_mo_dau IS NOT NULL ORDER BY (anh_mo_dau IS NOT NULL) DESC LIMIT 1");
const vid = await queryOne<{ url: string }>("SELECT url FROM video_ai WHERE id = 1");
const G = "http://127.0.0.1:3000";
const duVideo = await fetch(G + anDiaChiKho(vid!.url));
const than = await duVideo.arrayBuffer();
console.log(`Video cả tệp → ${duVideo.status}, ${duVideo.headers.get("content-type")}, ${than.byteLength} byte, Accept-Ranges: ${duVideo.headers.get("accept-ranges")}`);
const tua = await fetch(G + anDiaChiKho(vid!.url), { headers: { Range: "bytes=0-99" } });
console.log(`Tua 0-99 → ${tua.status}, Content-Range: ${tua.headers.get("content-range")}, ${(await tua.arrayBuffer()).byteLength} byte`);
const giua = await fetch(G + anDiaChiKho(vid!.url), { headers: { Range: "bytes=1000000-" } });
console.log(`Tua từ giữa → ${giua.status}, Content-Range: ${giua.headers.get("content-range")}, ${(await giua.arrayBuffer()).byteLength} byte`);
const qua = await fetch(G + anDiaChiKho(vid!.url), { headers: { Range: "bytes=99999999-" } });
console.log(`Tua quá cuối tệp → ${qua.status}`);
const anh = await fetch(G + anDiaChiKho(v!.anh_mo_dau));
console.log(`Ảnh (đường cũ) → ${anh.status}, ${anh.headers.get("content-type")}, ${(await anh.arrayBuffer()).byteLength} byte`);
const sai = await fetch(G + "/media/khong-hop-le");
console.log(`Mã /media sai → ${sai.status}`);
process.exit(0);
