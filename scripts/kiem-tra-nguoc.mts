 * (.invalid), không khoá Telegram / AI, khoá nhà cung cấp giả — mọi tác dụng phụ đều hỏng vô hại. (dotenv không ghi đè biến
 * đã có, đã đo: env.ts đọc đúng giá trị giả.) Bộ kiểm tra đạt đủ với khoá giả (1405/1405, 30/10).
 */
export const MOI_TRUONG_CO_LAP: Record<string, string> = {
  DATABASE_URL: "postgresql://gia:gia@khong-ton-tai.invalid:5432/gia",
  ZERNIO_API_KEY: "gia",
  ZERNIO_WEBHOOK_SECRET: "gia",
  OPENROUTER_API_KEY: "",
  TELEGRAM_BOT_TOKEN: "",
  TELEGRAM_POLLING: "false",
  SMTP_PASS: "",
};

function chayKiemTra(): boolean {
  try {
    execSync("npx tsx scripts/kiem-tra.mts", { cwd: GOC, stdio: "pipe", env: { ...process.env, ...MOI_TRUONG_CO_LAP } });
    return true; // đạt hết
  } catch {
    return false; // có điểm hỏng
  }
}

const goc = new Map<string, string>();
function luu(tep: string): void {
  if (!goc.has(tep)) goc.set(tep, fs.readFileSync(path.join(GOC, tep), "utf8"));
}
function traLai(): void {
  for (const [tep, noi] of goc) fs.writeFileSync(path.join(GOC, tep), noi);
}

// Không cần trả lại khi thoát: mọi lỗ đều đục trên bản sao, bản sao bị xoá cả.

console.log("Kiểm tra ngược: đục lỗ rồi xem bộ kiểm tra có kêu không.\n");

/*
 * Chặn tĩnh (TD-35): lỗ đục KHÔNG được nạp mô-đun lúc chạy (import( / require() — đúng cơ chế đã gây sự cố giả. Các lệnh
 * khác (query / fetch / gửi tin) có trong lỗ đục hợp lệ ở đường mã bộ kiểm tra không chạy; môi trường CÔ LẬP phía trên
 * làm chúng vô hại. Có lỗ vi phạm → dừng ngay, không đục gì.
 */
export const MAU_CAM_TRONG_LO_DUC = /\bimport\s*\(|\brequire\s*\(/;
const loDucCam = DUC.filter((d) => MAU_CAM_TRONG_LO_DUC.test(d.thay));
if (loDucCam.length) {
  console.error(`  ✗ Lỗ đục nạp mô-đun lúc chạy (cấm — TD-35): ${loDucCam.map((d) => d.ten).join("; ")}`);
  process.exit(1);
}

if (!chayKiemTra()) {
  console.error("Mã đang HỎNG sẵn — sửa cho bộ kiểm tra đạt hết rồi hãy chạy phép thử ngược.");
  process.exit(1);
}

let dởm = 0;
// GIOI_HAN=5 npm run kiem-tra-nguoc: chỉ đục vài lỗ đầu, để thử nhanh cơ chế.
// TU=480 npm run kiem-tra-nguoc: chỉ đục từ lỗ thứ 480 trở đi (thử nhanh các lỗ mới thêm).
const TU = Number(process.env.TU) || 0;
const GIOI_HAN = Number(process.env.GIOI_HAN) || DUC.length;
// TEN="mật khẩu|xem thay" npm run kiem-tra-nguoc: chỉ đục những lỗ có tên chứa một trong các cụm (tách bằng |).
// Đếm số thứ tự theo dòng dễ lệch khi danh sách đổi — chọn theo tên thì không.
const TEN = (process.env.TEN ?? "").split("|").map((t) => t.trim()).filter(Boolean);
// TEP="connections.ts|Connections.tsx" npm run kiem-tra-nguoc: chỉ đục lỗ trong các tệp vừa sửa (vài phút thay vì
// ~25 phút cho cả bộ) — dùng trong lúc làm; xong cả màn thì chạy đủ một lượt trước khi báo duyệt.
const TEP = (process.env.TEP ?? "").split("|").map((t) => t.trim()).filter(Boolean);
const CHON = DUC.slice(TU, GIOI_HAN)
  .filter((d) => TEN.length === 0 || TEN.some((t) => d.ten.includes(t)))
  .filter((d) => TEP.length === 0 || TEP.some((t) => d.tep.includes(t)));
// Lọc mà không khớp lỗ nào thì KHÔNG được báo xanh (phiên kiểm duyệt bắt được 18/10/2026: TEP tách bằng dấu phẩy khớp 0
// lỗ mà vẫn in "Mọi chốt chặn đều có phép kiểm thật đứng sau").
if ((TEN.length > 0 || TEP.length > 0) && CHON.length === 0) {
  console.error("  ✗ Bộ lọc TEN/TEP không khớp lỗ nào — không có gì được kiểm. Nhiều giá trị thì tách bằng dấu |, không dùng dấu phẩy.");
  process.exit(1);
}
for (const d of CHON) {
  luu(d.tep);
  const duong = path.join(GOC, d.tep);
  const truoc = goc.get(d.tep)!;
  const sau = truoc.replace(d.tim as never, d.thay);

  if (sau === truoc) {
    console.log(`  ⚠ ${d.ten}\n      không đục được — mã đã đổi, phải cập nhật lại phép thử này`);
    dởm++;
    continue;
  }

  fs.writeFileSync(duong, sau);
  const vanXanh = chayKiemTra();
  fs.writeFileSync(duong, truoc);

  if (vanXanh) {
    console.log(`  ✗ ${d.ten}\n      bộ kiểm tra VẪN BÁO ĐẠT — phép kiểm này là đồ giả`);
    dởm++;
  } else {
    console.log(`  ✓ ${d.ten} — bắt được`);
  }
}

